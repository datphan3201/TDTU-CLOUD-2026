$TTL 3600
@ IN SOA ns.cloud.local. admin.cloud.local. (
    2026111201 ; serial: tăng sau mỗi lần sửa zone
    3600       ; refresh
    900        ; retry
    604800     ; expire
    3600       ; negative cache TTL
)
@                   IN NS ns.cloud.local.
ns                  IN A  10.10.10.53
web-frontend-server IN A  10.10.10.10
app-backend         IN A  10.10.10.20
minio               IN A  10.10.10.40
keycloak            IN A  10.10.10.30
