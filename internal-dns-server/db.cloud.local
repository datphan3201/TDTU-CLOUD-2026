$TTL 3600
@ IN SOA ns.cloud.local. admin.cloud.local. (
    2026110801 ; serial: tăng sau mỗi lần sửa zone
    3600       ; refresh
    900        ; retry
    604800     ; expire
    3600       ; negative cache TTL
)
@                   IN NS ns.cloud.local.
ns                  IN A  10.10.10.53
web-frontend-server IN A  10.10.10.10
; TODO DNS-01: app-backend -> .20, minio -> .40, keycloak -> .30.
