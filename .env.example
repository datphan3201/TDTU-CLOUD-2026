# Sao chép thành .env; thay MSSV, tài khoản Docker Hub và mật khẩu trước khi demo.
STUDENT_ID=CHANGE_ME
DOCKERHUB_USERNAME=myminicloud
IMAGE_TAG=dev

# PUBLIC_BASE_URL phải trùng URL gateway mà trình duyệt sử dụng (không có / cuối).
# Nếu đổi GATEWAY_PORT=8088, đổi PUBLIC_BASE_URL=http://localhost:8088.
PUBLIC_BASE_URL=http://localhost
GATEWAY_PORT=80
GATEWAY_BIND_ADDRESS=127.0.0.1
LOCAL_BIND_ADDRESS=127.0.0.1

DB_ROOT_PASSWORD=lab-root-change-me
DB_NAME=minicloud
DB_HOST_PORT=3306
DB_USER=minicloud_app
DB_PASSWORD=lab-db-change-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=lab-auth-change-me
MINIO_ROOT_USER=minicloud_admin
MINIO_ROOT_PASSWORD=lab-storage-change-me
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=lab-grafana-change-me
